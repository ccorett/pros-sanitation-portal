  "private": true,
  "scripts": {
    "whereami": "node -e \"console.log(process.cwd())\"",
    "verify": "node -e \"require('fs').existsSync('package.json') ? console.log('Project Root OK') : process.exit(1)\"",
    "db:verify": "node scripts/verify-db.mjs",
    "db:verify:prisma": "node scripts/verify-prisma.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
