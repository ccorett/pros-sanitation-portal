# Neon PostgreSQL — https://neon.tech (use pooler URL; sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth — https://www.better-auth.com
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32-min-32-chars
# Must match the port Next.js uses (see terminal: "Local: http://localhost:XXXX")
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Production (Vercel): set BETTER_AUTH_URL and NEXT_PUBLIC_BETTER_AUTH_URL to your deployed app URL
# Optional extra origins (comma-separated; wildcards supported), e.g. https://*.vercel.app
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-domain.com,https://*.vercel.app

# Employee signup access (server-enforced)
# EMPLOYEE_SIGNUP_MODE: open | disabled | invite  (default: open — any email domain)
EMPLOYEE_SIGNUP_MODE=open
# Required when EMPLOYEE_SIGNUP_MODE=invite (comma-separated, keep secret)
SIGNUP_INVITE_CODES=

# Admin API — unlock login attempts / reactivate employee (Bearer token)
# ADMIN_API_SECRET=

# Password reset email (optional — dev logs link to terminal without this)
# RESEND_API_KEY=
# PASSWORD_RESET_EMAIL_FROM=Pro's Sanitation Portal <noreply@prossanitation.com>
