generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth core tables
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  employee      Employee?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActivityAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model LoginAttempt {
  email        String
  ipAddress    String
  attempts     Int       @default(0)
  lastFailedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@id([email, ipAddress])
  @@map("login_attempts")
}

model LoginIpRateLimit {
  ipAddress   String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("login_ip_rate_limits")
}

enum SecurityAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_DELAY_APPLIED
  ACCOUNT_LOCKOUT
  PASSWORD_RESET
  SESSION_EXPIRED
  IP_RATE_LIMITED
  UNAUTHORIZED_ROUTE_ACCESS
  UNAUTHORIZED_API_ACCESS
  ACCOUNT_REMOVED
  ACCOUNT_RESTORED
  ACCOUNT_PURGED

  @@map("SecurityAuditEventType")
}

model SecurityAuditLog {
  id          String                 @id @default(uuid()) @db.Uuid
  eventType   SecurityAuditEventType
  email       String?
  accessLevel AccessLevel?
  ipAddress   String?
  message     String?
  result      String?
  createdAt   DateTime               @default(now())

  @@index([eventType, createdAt])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("security_audit_logs")
}

enum EmploymentStatus {
  ACTIVE
  DISABLED
  ON_LEAVE
}

enum AccessLevel {
  PENDING_VERIFICATION
  TEAM_MEMBER
  SUPERVISOR
  MANAGER
  ADMIN
  SUPER_ADMIN

  @@map("PortalAccessLevel")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
  REMOVED
}

enum OperationalGroup {
  GENERAL
  BIN_TECHNICIAN
  BIN_SERVICE_SUPERVISOR

  @@map("OperationalGroup")
}

enum EmployeeResponsibility {
  GENERAL_OPERATIONS
  BIN_TECHNICIAN
  BIN_SERVICE_SUPERVISOR
  DRIVER
  DELIVERY_COORDINATOR
  STOCK_ACCESS
  HR_REVIEW
  ADMIN_SUPPORT
  ADMIN_ASSISTANT

  @@map("EmployeeResponsibility")
}

enum AccountAuditAction {
  ACCESS_LEVEL_CHANGED
  RESPONSIBILITIES_CHANGED
  ACCOUNT_DISABLED
  ACCOUNT_REMOVED
  ACCOUNT_RESTORED

  @@map("AccountAuditAction")
}

enum ClientLocationStatus {
  ACTIVE
  INACTIVE
}

enum CleaningJobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ISSUE_REPORTED
}

enum JobActionType {
  STARTED
  COMPLETED
  ISSUE_REPORTED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NoticeCategory {
  GENERAL
  SAFETY
  OPERATIONS
  HR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK
  VACATION
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique
  employeeId        String           @unique
  firstName         String
  lastName          String
  companyEmail      String           @unique
  phoneNumber            String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  profilePictureUrl      String?
  department             String
  jobTitle               String
  position               String?
  locationAssignment     String?
  supervisorName         String?
  employmentStatus  EmploymentStatus @default(ACTIVE)
  accessLevel       AccessLevel        @default(PENDING_VERIFICATION)
  operationalGroup  OperationalGroup   @default(GENERAL)
  accountStatus     AccountStatus      @default(PENDING)
  lastLoginAt       DateTime?
  lastEditedAt      DateTime?
  editedBy          String?
  removedAt         DateTime?
  scheduledPurgeAt  DateTime?
  restoreSnapshot   Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHistories        AccessHistory[]
  accountAuditLogs       AccountAuditLog[]
  responsibilityEntries  EmployeeResponsibilityEntry[]
  assignedJobs           Job[]
  assignedBinSetups      BinServiceSetup[]       @relation("BinSetupTechnician")
  assignedBinJobs        BinServiceJob[]         @relation("BinJobTechnician")
  binServiceLogs         BinServiceLog[]         @relation("BinLogTechnician")
  policyAcknowledgements PolicyAcknowledgement[]
  noticeAcknowledgements NoticeAcknowledgement[]
  jobAssignments         JobAssignment[]
  locationAssignments    EmployeeLocationAssignment[]
  jobServiceLogs         JobServiceLog[]
  payslips               Payslip[]
  assignedDeliveryRequests DeliveryRequest[] @relation("DeliveryDriver")
  attendanceLogsSupervised AttendanceLog[]   @relation("AttendanceSupervisor")
  attendanceLogs           AttendanceLog[]   @relation("AttendanceEmployee")

  @@map("employees")
}

model AccessHistory {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  previousLevel AccessLevel
  newLevel      AccessLevel
  changedBy     String
  changedAt     DateTime    @default(now())
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([changedAt])
  @@map("access_history")
}

model EmployeeResponsibilityEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  employeeId     String                 @db.Uuid
  responsibility EmployeeResponsibility
  createdAt      DateTime               @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, responsibility])
  @@index([employeeId])
  @@map("employee_responsibilities")
}

model AccountAuditLog {
  id            String             @id @default(uuid()) @db.Uuid
  employeeId    String?            @db.Uuid
  employeeName  String
  action        AccountAuditAction
  previousValue String?
  newValue      String?
  changedBy     String
  changedAt     DateTime           @default(now())
  notes         String?

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([changedAt])
  @@map("account_audit_logs")
}

model ClientLocation {
  id                 String               @id @default(uuid()) @db.Uuid
  slug               String               @unique
  locationName       String
  clientName         String
  serviceType        String?
  area               String               @default("")
  address            String
  assignedTechnician String               @default("")
  serviceDay         String               @default("")
  status             ClientLocationStatus @default(ACTIVE)
  lastServiceDate    DateTime?            @db.Date
  nextServiceDate    DateTime?            @db.Date
  notes              String?
  siteName           String?
  contactPerson      String?
  contactNumber      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  jobs            Job[]
  jobAssignments  JobAssignment[]

  @@index([status])
  @@map("client_locations")
}

model EmployeeLocationAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @db.Uuid
  locationName String
  isPrimary    Boolean  @default(false)
  assignedBy   String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, locationName])
  @@index([employeeId, isActive])
  @@map("employee_location_assignments")
}

model JobAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid
  employeeName     String
  employeeEmail    String
  clientLocationId String   @db.Uuid
  clientLocation   String
  assignedRole     String
  assignedBy       String
  assignedAt       DateTime @default(now())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location         ClientLocation @relation(fields: [clientLocationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, clientLocationId])
  @@index([employeeId, isActive])
  @@index([clientLocationId])
  @@map("job_assignments")
}

model Job {
  id                   String            @id @default(uuid()) @db.Uuid
  title                String
  clientLocationId     String            @db.Uuid
  clientLocation       String
  serviceType          String
  assignedEmployeeId   String?           @db.Uuid
  assignedEmployeeName String?
  assignedEmployeeEmail String?
  assignedBy           String
  scheduledDate        DateTime          @db.Date
  dueDate              DateTime          @db.Date
  priority             JobPriority       @default(NORMAL)
  status               CleaningJobStatus @default(PENDING)
  notes                String?
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  location         ClientLocation @relation(fields: [clientLocationId], references: [id], onDelete: Restrict)
  assignedEmployee Employee?      @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  serviceLogs      JobServiceLog[]

  @@index([assignedEmployeeId])
  @@index([clientLocationId])
  @@index([scheduledDate])
  @@index([status])
  @@map("jobs")
}

model JobServiceLog {
  id            String         @id @default(uuid()) @db.Uuid
  jobId         String         @db.Uuid
  job           String
  employeeId    String?        @db.Uuid
  employeeName  String
  employeeEmail String
  actionType    JobActionType
  notes         String?
  issueNotes    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  cleaningJob Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("job_service_logs")
}

model InternalNotice {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  body        String
  category    NoticeCategory
  publishedAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  acknowledgements NoticeAcknowledgement[]

  @@map("internal_notices")
}

enum PolicyStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Policy {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  body          String
  category      String
  version       String
  status        PolicyStatus @default(ACTIVE)
  effectiveDate DateTime     @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@map("policies")
}

model PolicyAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  policyId       String   @db.Uuid
  acknowledgedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, policyId])
  @@map("policy_acknowledgements")
}

model NoticeAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  noticeId       String   @db.Uuid
  acknowledgedAt DateTime @default(now())

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  notice   InternalNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, noticeId])
  @@map("notice_acknowledgements")
}

enum BinWeekPattern {
  WEEK_1_3
  WEEK_2_4
}

enum ServiceDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BinServiceJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANNOT_ACCESS
  ISSUE_REPORTED
}

enum BinServiceLogOutcome {
  COMPLETED
  CANNOT_ACCESS
  ISSUE_REPORTED
}

model BinClient {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sites     BinServiceSite[]

  @@map("bin_clients")
}

model BinServiceSite {
  id        String           @id @default(uuid()) @db.Uuid
  clientId  String           @db.Uuid
  name      String
  area      String?
  address   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  client BinClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  setup  BinServiceSetup?
  jobs   BinServiceJob[]
  logs   BinServiceLog[]

  @@index([clientId])
  @@map("bin_service_sites")
}

model BinServiceSetup {
  id                       String            @id @default(uuid()) @db.Uuid
  siteId                   String            @unique @db.Uuid
  expectedRegularBins      Int               @default(0)
  expectedNewBins          Int               @default(0)
  weekPattern              BinWeekPattern
  serviceDay               ServiceDayOfWeek
  assignedTechnicianId     String?           @db.Uuid
  accessInstructions       String?
  contactName              String?
  contactPhone             String?
  signatureRequired        Boolean           @default(false)
  active                   Boolean           @default(true)
  lastCompletedServiceDate DateTime?         @db.Date
  nextServiceDate          DateTime?         @db.Date
  removedAt                DateTime?
  removedBy                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  site               BinServiceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedTechnician Employee?      @relation("BinSetupTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  jobs               BinServiceJob[]

  @@index([assignedTechnicianId])
  @@index([nextServiceDate])
  @@map("bin_service_setups")
}

model BinServiceJob {
  id                   String              @id @default(uuid()) @db.Uuid
  setupId              String              @db.Uuid
  siteId               String              @db.Uuid
  assignedTechnicianId String              @db.Uuid
  scheduledDate        DateTime            @db.Date
  status               BinServiceJobStatus @default(SCHEDULED)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  setup              BinServiceSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  site               BinServiceSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedTechnician Employee        @relation("BinJobTechnician", fields: [assignedTechnicianId], references: [id], onDelete: Restrict)
  logs               BinServiceLog[]

  @@unique([setupId, scheduledDate])
  @@index([assignedTechnicianId, scheduledDate])
  @@index([siteId])
  @@index([status])
  @@map("bin_service_jobs")
}

model BinServiceLog {
  id                  String               @id @default(uuid()) @db.Uuid
  jobId               String               @db.Uuid
  siteId              String               @db.Uuid
  technicianId        String?              @db.Uuid
  technicianDisplayName String?
  regularBinsExpected Int
  regularBinsServiced Int
  newBinsExpected     Int
  newBinsServiced     Int
  linersUsed          Int
  issueType           String?
  issueNotes          String?
  serviceNotes        String?
  clientSignatureName String?
  noSignatureReason   String?
  outcome             BinServiceLogOutcome
  completedAt         DateTime             @default(now())

  job        BinServiceJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  site       BinServiceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technician Employee?       @relation("BinLogTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([siteId])
  @@index([technicianId])
  @@index([completedAt])
  @@map("bin_service_logs")
}

model BinLocationImportLog {
  id            String   @id @default(uuid()) @db.Uuid
  fileName      String
  importedById  String?  @db.Uuid
  importedBy    String
  importedAt    DateTime @default(now())
  totalRows     Int
  createdCount  Int
  updatedCount  Int
  skippedCount  Int
  errorCount    Int

  @@index([importedAt])
  @@map("bin_location_import_logs")
}

enum InventoryCategory {
  EQUIPMENT
  CHEMICALS
  PPE
  CONSUMABLES
}

model InventoryItem {
  id                String            @id @default(cuid())
  itemName          String
  category          InventoryCategory
  availableQuantity Int
  unit              String
  reorderLevel      Int
  storageArea       String
  supplier          String?
  isActive                  Boolean           @default(true)
  purchasingExcludedFromList Boolean          @default(false)
  purchasingOrderedAt       DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  lastEditedAt              DateTime?
  lastEditedBy              String?

  stockEditHistory StockEditHistory[]
  equipmentRequests EquipmentRequest[]

  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryImportLog {
  id            String   @id @default(uuid()) @db.Uuid
  fileName      String
  importedById  String?  @db.Uuid
  importedBy    String
  importedAt    DateTime @default(now())
  totalRows     Int
  createdCount  Int
  updatedCount  Int
  skippedCount  Int
  errorCount    Int

  @@index([importedAt])
  @@map("inventory_import_logs")
}

model StockEditHistory {
  id                   String   @id @default(cuid())
  inventoryItemId      String
  previousQuantity     Int
  newQuantity          Int
  previousReorderLevel Int?
  newReorderLevel      Int?
  previousStorageArea  String?
  newStorageArea       String?
  previousSupplier     String?
  newSupplier          String?
  editedBy             String
  editedAt             DateTime @default(now())
  notes                String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([editedAt])
  @@map("stock_edit_history")
}

enum RequestUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EquipmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model EquipmentRequest {
  id                String                 @id @default(cuid())
  inventoryItemId   String
  requestedById     String
  requestedByName   String
  requestedByEmail  String
  quantityRequested Int
  reason            String
  urgency           RequestUrgency
  status            EquipmentRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  decisionNotes     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  deliveryRequest DeliveryRequest?

  @@index([inventoryItemId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@map("equipment_requests")
}

enum DeliveryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryRequestStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  FULFILLED
  CANCELLED
  CANNOT_FULFIL
}

model DeliveryRequest {
  id                        String                @id @default(cuid())
  requestNumber             String                @unique
  status                    DeliveryRequestStatus @default(PENDING)
  priority                  DeliveryPriority      @default(NORMAL)
  requestedById             String                @db.Uuid
  requestedByName           String
  requestedByEmail          String
  requestingLocation        String
  responsibleSupervisorId   String?               @db.Uuid
  responsibleSupervisorName String?
  assignedDriverId          String?               @db.Uuid
  assignedDriverName        String?
  requestedDate             DateTime
  notes                     String?
  equipmentRequestId        String?               @unique
  createdById               String                @db.Uuid
  createdByName             String
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  assignedDriver   Employee?               @relation("DeliveryDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  equipmentRequest EquipmentRequest?       @relation(fields: [equipmentRequestId], references: [id], onDelete: SetNull)
  items            DeliveryRequestItem[]
  statusHistory    DeliveryStatusHistory[]

  @@index([status])
  @@index([assignedDriverId])
  @@index([requestedDate])
  @@index([createdAt])
  @@map("delivery_requests")
}

model DeliveryRequestItem {
  id                String @id @default(cuid())
  deliveryRequestId String
  itemName          String
  quantity          Int
  inventoryItemId   String?

  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)

  @@index([deliveryRequestId])
  @@map("delivery_request_items")
}

model DeliveryStatusHistory {
  id                String                 @id @default(cuid())
  deliveryRequestId String
  previousStatus    DeliveryRequestStatus?
  newStatus         DeliveryRequestStatus
  changedById       String                 @db.Uuid
  changedByName     String
  notes             String?
  changedAt         DateTime               @default(now())

  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)

  @@index([deliveryRequestId])
  @@index([changedAt])
  @@map("delivery_status_history")
}

enum VacationSupervisorStatus {
  PENDING
  AWARE
  UNAWARE
}

enum VacationManagerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VacationFinalStatus {
  PENDING_SUPERVISOR_REVIEW
  PENDING_MANAGER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model VacationRequest {
  id                   String                   @id @default(cuid())
  employeeId           String
  employeeName         String
  employeeEmail        String
  locationAssignment   String
  supervisorId         String?
  supervisorName       String?
  startDate            DateTime
  endDate              DateTime
  reason               String
  supervisorStatus     VacationSupervisorStatus @default(PENDING)
  supervisorNotes      String?
  supervisorReviewedAt DateTime?
  managerStatus        VacationManagerStatus    @default(PENDING)
  managerNotes         String?
  managerReviewedById  String?
  managerReviewedByName String?
  managerReviewedAt    DateTime?
  finalStatus          VacationFinalStatus      @default(PENDING_SUPERVISOR_REVIEW)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([employeeId])
  @@index([locationAssignment])
  @@index([supervisorId])
  @@index([finalStatus])
  @@index([createdAt])
  @@map("vacation_requests")
}

enum JobLetterType {
  JOB_LETTER
  EMPLOYMENT_LETTER
  SALARY_LETTER
}

enum JobLetterRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobLetterRequest {
  id               String                 @id @default(cuid())
  employeeId       String
  employeeName     String
  employeeEmail    String
  letterType       JobLetterType
  notes            String?
  status           JobLetterRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  decisionNotes    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("job_letter_requests")
}

enum PayslipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PayslipRequest {
  id               String               @id @default(cuid())
  employeeId       String
  employeeName     String
  employeeEmail    String
  payPeriod        String
  notes            String?
  status           PayslipRequestStatus @default(PENDING)
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  decisionNotes    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("payslip_requests")
}

model Payslip {
  id                      String    @id @default(uuid()) @db.Uuid
  employeeId              String?   @db.Uuid
  employeeName            String
  employeeEmail           String?
  payPeriod               String
  grossPay                Decimal?  @db.Decimal(12, 2)
  healthSurcharge         Decimal?  @db.Decimal(12, 2)
  nis                     Decimal?  @db.Decimal(12, 2)
  paye                    Decimal?  @db.Decimal(12, 2)
  companyDeductions       Decimal?  @db.Decimal(12, 2)
  netPay                  Decimal?  @db.Decimal(12, 2)
  grossPayDetails         String?
  companyDeductionDetails String?
  fileName                String?
  fileUrl                 String?
  uploadedBy              String?
  uploadedAt              DateTime  @default(now())
  importedAt              DateTime?
  archived                Boolean   @default(false)
  source                  String?

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([employeeId, payPeriod])
  @@index([employeeId])
  @@index([payPeriod])
  @@index([archived])
  @@index([uploadedAt])
  @@index([importedAt])
  @@map("employee_payslips")
}

model PayslipImportLog {
  id                 String   @id @default(uuid()) @db.Uuid
  importedById       String?  @db.Uuid
  importedByName     String
  importedAt         DateTime @default(now())
  fileName           String
  recordsImported    Int
  recordsUpdated     Int
  recordsSkipped     Int
  unmatchedEmployees Json     @default("[]")

  @@index([importedAt])
  @@map("payslip_import_logs")
}

model AttendanceLog {
  id                    String           @id @default(uuid()) @db.Uuid
  attendanceDate        DateTime         @db.Date
  location              String
  supervisorId          String?          @db.Uuid
  supervisorDisplayName String?
  employeeId            String?          @db.Uuid
  employeeDisplayName   String?
  status                AttendanceStatus
  checkInTime           DateTime?
  notes                 String?
  createdAt             DateTime         @default(now())

  supervisor Employee? @relation("AttendanceSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  employee   Employee? @relation("AttendanceEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([attendanceDate, employeeId, location])
  @@index([attendanceDate])
  @@index([location])
  @@index([supervisorId])
  @@index([employeeId])
  @@map("attendance_logs")
}

enum InvoiceBillingCycle {
  MONTHLY
  ANNUALLY

  @@map("InvoiceBillingCycle")
}

enum InvoiceServiceType {
  CLEANING_SERVICES
  BIN_SERVICES
  OTHER

  @@map("InvoiceServiceType")
}

enum InvoiceClientStatus {
  ACTIVE
  INACTIVE
  REMOVED

  @@map("InvoiceClientStatus")
}

enum InvoiceScheduleStatus {
  UPCOMING
  DUE_SOON
  DUE
  GENERATED
  SUBMITTED
  SNOOZED
  OVERDUE

  @@map("InvoiceScheduleStatus")
}

enum InvoiceAlertType {
  INVOICE_REMINDER

  @@map("InvoiceAlertType")
}

enum InvoiceAlertLogType {
  FIVE_DAY_REMINDER
  DUE_DATE_REMINDER
  OVERDUE_REMINDER

  @@map("InvoiceAlertLogType")
}

enum InvoiceAlertLogStatus {
  SENT
  FAILED
  SKIPPED

  @@map("InvoiceAlertLogStatus")
}

model InvoiceClient {
  id                   String              @id @default(uuid()) @db.Uuid
  clientName           String
  serviceType          InvoiceServiceType  @default(CLEANING_SERVICES)
  billingCycle         InvoiceBillingCycle
  invoiceCountPerCycle Int                 @default(1)
  usualDueDay          Int                 @default(1)
  annualDueMonth       Int?
  status               InvoiceClientStatus @default(ACTIVE)
  remarks              String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  schedules InvoiceSchedule[]

  @@index([status])
  @@index([clientName, serviceType, billingCycle])
  @@map("invoice_clients")
}

model InvoiceSchedule {
  id           String                @id @default(uuid()) @db.Uuid
  clientId     String                @db.Uuid
  cycleMonth   Int
  cycleYear    Int
  dueDate      DateTime              @db.Date
  reminderDate DateTime              @db.Date
  status       InvoiceScheduleStatus @default(UPCOMING)
  generatedAt  DateTime?
  submittedAt  DateTime?
  snoozedUntil DateTime?             @db.Date
  remarks      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  client InvoiceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, cycleMonth, cycleYear])
  @@index([dueDate])
  @@index([status])
  @@map("invoice_schedules")
}

model InvoiceAlertRecipient {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  name      String
  roleLabel String?
  isActive  Boolean          @default(true)
  alertType InvoiceAlertType @default(INVOICE_REMINDER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([email, alertType])
  @@map("invoice_alert_recipients")
}

model InvoiceAlertLog {
  id             String                @id @default(uuid()) @db.Uuid
  alertDate      DateTime              @db.Date
  alertType      InvoiceAlertLogType
  recipientEmail String
  invoiceCount   Int
  sentAt         DateTime?
  status         InvoiceAlertLogStatus
  errorMessage   String?
  createdAt      DateTime              @default(now())

  @@unique([alertDate, alertType, recipientEmail])
  @@index([alertDate])
  @@map("invoice_alert_logs")
}
