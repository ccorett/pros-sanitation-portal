generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth core tables
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  employee      Employee?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model LoginAttempt {
  email     String   @id
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("login_attempts")
}

enum EmploymentStatus {
  ACTIVE
  DISABLED
  ON_LEAVE
}

enum AccessLevel {
  PENDING_VERIFICATION
  TEAM_MEMBER
  SUPERVISOR
  MANAGER
  ADMIN
  SUPER_ADMIN

  @@map("PortalAccessLevel")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
  REMOVED
}

enum OperationalGroup {
  GENERAL
  BIN_TECHNICIAN
  BIN_SERVICE_SUPERVISOR

  @@map("OperationalGroup")
}

enum ClientLocationStatus {
  ACTIVE
  INACTIVE
}

enum ServiceType {
  SANITARY_BIN_SERVICE
  GROCERY_CLEANING
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ISSUE_REPORTED
}

enum NoticeCategory {
  GENERAL
  SAFETY
  OPERATIONS
  HR
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique
  employeeId        String           @unique
  firstName         String
  lastName          String
  companyEmail      String           @unique
  phoneNumber        String?
  department         String
  jobTitle           String
  position           String?
  locationAssignment String?
  supervisorName    String?
  employmentStatus  EmploymentStatus @default(ACTIVE)
  accessLevel       AccessLevel        @default(PENDING_VERIFICATION)
  operationalGroup  OperationalGroup   @default(GENERAL)
  accountStatus     AccountStatus      @default(PENDING)
  lastLoginAt       DateTime?
  lastEditedAt      DateTime?
  editedBy          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHistories        AccessHistory[]
  assignedJobs           Job[]
  assignedBinSetups      BinServiceSetup[]       @relation("BinSetupTechnician")
  assignedBinJobs        BinServiceJob[]         @relation("BinJobTechnician")
  binServiceLogs         BinServiceLog[]         @relation("BinLogTechnician")
  policyAcknowledgements PolicyAcknowledgement[]
  noticeAcknowledgements NoticeAcknowledgement[]

  @@map("employees")
}

model AccessHistory {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  previousLevel AccessLevel
  newLevel      AccessLevel
  changedBy     String
  changedAt     DateTime    @default(now())
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([changedAt])
  @@map("access_history")
}

model ClientLocation {
  id            String               @id @default(uuid()) @db.Uuid
  clientName    String
  siteName      String?
  address       String
  contactPerson String?
  contactNumber String?
  status        ClientLocationStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  jobs Job[]

  @@map("client_locations")
}

model Job {
  id                 String      @id @default(uuid()) @db.Uuid
  jobCode            String      @unique
  clientLocationId   String      @db.Uuid
  assignedEmployeeId String      @db.Uuid
  serviceType        ServiceType
  scheduledDate      DateTime    @db.Date
  instructions       String?
  status             JobStatus   @default(NOT_STARTED)
  completionNotes    String?
  issueNotes         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  clientLocation   ClientLocation @relation(fields: [clientLocationId], references: [id], onDelete: Restrict)
  assignedEmployee Employee       @relation(fields: [assignedEmployeeId], references: [id], onDelete: Restrict)

  @@index([assignedEmployeeId])
  @@index([clientLocationId])
  @@index([scheduledDate])
  @@map("jobs")
}

model InternalNotice {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  body        String
  category    NoticeCategory
  publishedAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  acknowledgements NoticeAcknowledgement[]

  @@map("internal_notices")
}

model Policy {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  body          String
  version       String
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@map("policies")
}

model PolicyAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  policyId       String   @db.Uuid
  acknowledgedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, policyId])
  @@map("policy_acknowledgements")
}

model NoticeAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  noticeId       String   @db.Uuid
  acknowledgedAt DateTime @default(now())

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  notice   InternalNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, noticeId])
  @@map("notice_acknowledgements")
}

enum BinWeekPattern {
  WEEK_1_3
  WEEK_2_4
}

enum ServiceDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BinServiceJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANNOT_ACCESS
  ISSUE_REPORTED
}

enum BinServiceLogOutcome {
  COMPLETED
  CANNOT_ACCESS
  ISSUE_REPORTED
}

model BinClient {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sites     BinServiceSite[]

  @@map("bin_clients")
}

model BinServiceSite {
  id        String           @id @default(uuid()) @db.Uuid
  clientId  String           @db.Uuid
  name      String
  area      String?
  address   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  client BinClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  setup  BinServiceSetup?
  jobs   BinServiceJob[]
  logs   BinServiceLog[]

  @@index([clientId])
  @@map("bin_service_sites")
}

model BinServiceSetup {
  id                       String            @id @default(uuid()) @db.Uuid
  siteId                   String            @unique @db.Uuid
  expectedRegularBins      Int               @default(0)
  expectedNewBins          Int               @default(0)
  weekPattern              BinWeekPattern
  serviceDay               ServiceDayOfWeek
  assignedTechnicianId     String?           @db.Uuid
  accessInstructions       String?
  contactName              String?
  contactPhone             String?
  signatureRequired        Boolean           @default(false)
  active                   Boolean           @default(true)
  lastCompletedServiceDate DateTime?         @db.Date
  nextServiceDate          DateTime?         @db.Date
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  site               BinServiceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedTechnician Employee?      @relation("BinSetupTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  jobs               BinServiceJob[]

  @@index([assignedTechnicianId])
  @@index([nextServiceDate])
  @@map("bin_service_setups")
}

model BinServiceJob {
  id                   String              @id @default(uuid()) @db.Uuid
  setupId              String              @db.Uuid
  siteId               String              @db.Uuid
  assignedTechnicianId String              @db.Uuid
  scheduledDate        DateTime            @db.Date
  status               BinServiceJobStatus @default(SCHEDULED)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  setup              BinServiceSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  site               BinServiceSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedTechnician Employee        @relation("BinJobTechnician", fields: [assignedTechnicianId], references: [id], onDelete: Restrict)
  logs               BinServiceLog[]

  @@unique([setupId, scheduledDate])
  @@index([assignedTechnicianId, scheduledDate])
  @@index([siteId])
  @@index([status])
  @@map("bin_service_jobs")
}

model BinServiceLog {
  id                  String               @id @default(uuid()) @db.Uuid
  jobId               String               @db.Uuid
  siteId              String               @db.Uuid
  technicianId        String               @db.Uuid
  regularBinsExpected Int
  regularBinsServiced Int
  newBinsExpected     Int
  newBinsServiced     Int
  linersUsed          Int
  issueType           String?
  issueNotes          String?
  clientSignatureName String?
  noSignatureReason   String?
  outcome             BinServiceLogOutcome
  completedAt         DateTime             @default(now())

  job        BinServiceJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  site       BinServiceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technician Employee       @relation("BinLogTechnician", fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@index([siteId])
  @@index([technicianId])
  @@index([completedAt])
  @@map("bin_service_logs")
}

enum InventoryCategory {
  EQUIPMENT
  CHEMICALS
  PPE
  CONSUMABLES
}

model InventoryItem {
  id                String            @id @default(cuid())
  itemName          String
  category          InventoryCategory
  availableQuantity Int
  unit              String
  reorderLevel      Int
  storageArea       String
  supplier          String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastEditedAt      DateTime?
  lastEditedBy      String?

  stockEditHistory StockEditHistory[]
  equipmentRequests EquipmentRequest[]

  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

model StockEditHistory {
  id                   String   @id @default(cuid())
  inventoryItemId      String
  previousQuantity     Int
  newQuantity          Int
  previousReorderLevel Int?
  newReorderLevel      Int?
  previousStorageArea  String?
  newStorageArea       String?
  previousSupplier     String?
  newSupplier          String?
  editedBy             String
  editedAt             DateTime @default(now())
  notes                String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([editedAt])
  @@map("stock_edit_history")
}

enum RequestUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EquipmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model EquipmentRequest {
  id                String                 @id @default(cuid())
  inventoryItemId   String
  requestedById     String
  requestedByName   String
  requestedByEmail  String
  quantityRequested Int
  reason            String
  urgency           RequestUrgency
  status            EquipmentRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  decisionNotes     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@map("equipment_requests")
}

enum VacationSupervisorStatus {
  PENDING
  AWARE
  UNAWARE
}

enum VacationManagerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VacationFinalStatus {
  PENDING_SUPERVISOR_REVIEW
  PENDING_MANAGER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model VacationRequest {
  id                   String                   @id @default(cuid())
  employeeId           String
  employeeName         String
  employeeEmail        String
  locationAssignment   String
  supervisorId         String?
  supervisorName       String?
  startDate            DateTime
  endDate              DateTime
  reason               String
  supervisorStatus     VacationSupervisorStatus @default(PENDING)
  supervisorNotes      String?
  supervisorReviewedAt DateTime?
  managerStatus        VacationManagerStatus    @default(PENDING)
  managerNotes         String?
  managerReviewedById  String?
  managerReviewedByName String?
  managerReviewedAt    DateTime?
  finalStatus          VacationFinalStatus      @default(PENDING_SUPERVISOR_REVIEW)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([employeeId])
  @@index([locationAssignment])
  @@index([supervisorId])
  @@index([finalStatus])
  @@index([createdAt])
  @@map("vacation_requests")
}
